/**app.wxss - 适老化全局样式 v2**/
page {
  background-color: #f4f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1a1a1a;
  /* 基础字号提升到 32rpx（原 28rpx），老人看着不吃力 */
  font-size: 32rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ===== 按钮 ===== */
.btn,
button[type="default"],
button[type="primary"] {
  font-size: 32rpx !important;
  min-height: 80rpx;
  border-radius: 16rpx !important;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.btn-primary {
  background-color: #2196F3;
  color: white;
  border: none;
}

.btn-primary:active {
  background-color: #0b7be5;
  transform: scale(0.98);
}

.btn-danger {
  background-color: #E53935;
  color: white;
  border: none;
}

.btn-danger:active {
  background-color: #b71c1c;
}

.btn-ghost {
  background-color: white;
  color: #2196F3;
  border: 2rpx solid #2196F3;
}

.btn-ghost:active {
  background-color: #f0f8ff;
}

/* ===== 卡片 ===== */
.card {
  background-color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(33, 150, 243, 0.08);
}

.card-card {
  /* 备选：更精致的卡片 */
  background: linear-gradient(180deg, #ffffff 0%, #fafcff 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin: 24rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* ===== 文字 ===== */
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.text {
  font-size: 30rpx;
  color: #555;
  line-height: 1.7;
}

.text-strong {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 600;
}

/* ===== 输入 ===== */
input,
textarea {
  font-size: 32rpx !important;
  color: #1a1a1a;
  background-color: #f8f9fc;
  padding: 24rpx;
  border-radius: 16rpx;
  min-height: 80rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

input:focus,
textarea:focus {
  background-color: white;
  border-color: #2196F3;
}

.placeholder {
  color: #aaa !important;
  font-size: 30rpx !important;
}

/* ===== 分区 ===== */
.section {
  padding: 24rpx;
  margin-top: 16rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin: 24rpx 8rpx 20rpx;
  display: flex;
  align-items: center;
}

.section-title-tag {
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #2196F3, #1976D2);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* ===== 风险等级 ===== */
.risk-level {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 12rpx;
}

.risk-high {
  background: linear-gradient(135deg, #ffebee, #ffcdd2);
  color: #b71c1c;
  box-shadow: 0 2rpx 8rpx rgba(229, 57, 53, 0.25);
}

.risk-medium {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
  color: #e65100;
  box-shadow: 0 2rpx 8rpx rgba(230, 81, 0, 0.25);
}

.risk-low {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  color: #2e7d32;
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.25);
}

.risk-none {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  color: #1565c0;
  box-shadow: 0 2rpx 8rpx rgba(21, 101, 192, 0.25);
}

/* ===== 列表项 ===== */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background-color: white;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.list-item:active {
  background-color: #f0f8ff;
  transform: scale(0.99);
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 40rpx;
  font-size: 30rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  display: block;
}

/* ===== 通用间距 ===== */
.gap-sm { margin: 12rpx 0; }
.gap-md { margin: 24rpx 0; }
.gap-lg { margin: 40rpx 0; }

/* ===== 适老化 toggle ===== */
.font-large {
  /* 在需要增强字号的地方额外+6rpx */
}

.font-large .title,
.font-large .text-strong {
  font-size: 46rpx !important;
}

.font-large .subtitle,
.font-large .text {
  font-size: 36rpx !important;
}
