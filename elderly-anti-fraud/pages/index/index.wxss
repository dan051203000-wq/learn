.container {
  padding: 0;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
  color: white;
  padding: 40rpx 30rpx;
  text-align: center;
}

.greeting {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 快速导航 */
.quick-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 20rpx;
  background-color: white;
  margin: 20rpx 0;
}

.nav-item {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.nav-item:active {
  background-color: #f0f0f0;
}

.nav-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.nav-desc {
  font-size: 22rpx;
  color: #999;
}

/* 分区 */
.section {
  padding: 20rpx;
  margin-top: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

/* 警报卡片 */
.alert-card {
  background-color: white;
  border-left: 4rpx solid #ff6b6b;
  padding: 20rpx;
  margin-bottom: 15rpx;
  border-radius: 8rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.alert-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.alert-date {
  font-size: 22rpx;
  color: #999;
}

/* 家庭守护卡片 */
.guardian-card {
  background: linear-gradient(135deg, #81C784 0%, #66BB6A 100%);
  color: white;
  padding: 30rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.guardian-info {
  flex: 1;
}

.guardian-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.guardian-status {
  font-size: 24rpx;
  opacity: 0.9;
}

.guardian-btn {
  background-color: rgba(255, 255, 255, 0.3);
  color: white;
  border: 2rpx solid white;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
