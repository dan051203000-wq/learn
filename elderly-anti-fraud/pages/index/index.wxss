/* ========== 首页 v2：适老化 + 现代化 ========== */
.container {
  padding: 0 0 60rpx;
  background-color: #f4f6fa;
  min-height: 100vh;
}

/* ===== 顶部 banner ===== */
.header {
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 50%, #1565C0 100%);
  color: white;
  padding: 40rpx 32rpx 80rpx;
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.header::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.header-greeting {
  display: flex;
  align-items: center;
  flex: 1;
}

.header-wave {
  font-size: 56rpx;
  margin-right: 16rpx;
}

.header-text {
  flex: 1;
}

.header-name {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.header-sub {
  font-size: 26rpx;
  opacity: 0.85;
}

/* 首页右上角 logo 圆形徽章 */
.header-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: white;
  border: 4rpx solid white;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15), 0 0 0 2rpx rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin: 32rpx 0 16rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.header-tip {
  font-size: 28rpx;
  background-color: rgba(255, 255, 255, 0.18);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  display: inline-block;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(10rpx);
}

.header-disclaimer {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

/* ===== 首屏焦点：AI 亮点入口卡 ===== */
.hero-highlights {
  padding: 0 24rpx;
  margin-top: -50rpx;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero-card {
  position: relative;
  display: flex;
  align-items: center;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: all 0.2s;
}

.hero-card:active {
  transform: scale(0.98);
}

.hero-card-blue {
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 60%, #0D47A1 100%);
  color: white;
}

.hero-card-red {
  background: linear-gradient(135deg, #e53935 0%, #c62828 60%, #b71c1c 100%);
  color: white;
}

.hero-card-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
  z-index: 2;
}

.hero-card-body {
  flex: 1;
  z-index: 2;
}

.hero-card-title {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.hero-card-sub {
  font-size: 24rpx;
  opacity: 0.92;
  line-height: 1.4;
}

.hero-card-tag {
  background: rgba(255, 255, 255, 0.22);
  color: white;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  z-index: 2;
}

.hero-card-tag-urgent {
  background: rgba(255, 255, 255, 0.95);
  color: #c62828;
  font-weight: bold;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 救援卡的脉冲动画，强调紧迫感 */
.hero-card-pulse {
  position: absolute;
  top: 50%;
  right: -40rpx;
  transform: translateY(-50%);
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  animation: hero-pulse 2.2s ease-out infinite;
  pointer-events: none;
}

@keyframes hero-pulse {
  0% { transform: translateY(-50%) scale(0.7); opacity: 0.8; }
  100% { transform: translateY(-50%) scale(1.6); opacity: 0; }
}

/* ===== 4 大核心功能（2x2 大卡片） ===== */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.grid-item {
  background: white;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.12);
  transition: all 0.2s;
}

.grid-item:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(33, 150, 243, 0.15);
}

.grid-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.grid-icon-blue {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
}

.grid-icon-green {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}

.grid-icon-red {
  background: linear-gradient(135deg, #ffebee, #ffcdd2);
}

.grid-icon-orange {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
}

.grid-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.grid-desc {
  font-size: 24rpx;
  color: #888;
}

/* ===== AI 智能体横幅（首屏焦点） ===== */
.ai-banner {
  position: relative;
  margin: 24rpx;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  box-shadow: 0 10rpx 30rpx rgba(118, 75, 162, 0.35);
  overflow: hidden;
  transition: all 0.2s;
}

.ai-banner:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(118, 75, 162, 0.4);
}

.ai-banner-glow {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.25), transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.ai-banner-hot {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #ff6b6b, #ee5a52);
  color: white;
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 107, 0.4);
  z-index: 2;
}

.ai-banner-row {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.ai-banner-icon {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-banner-emoji {
  font-size: 80rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
  z-index: 2;
}

.ai-banner-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  animation: ai-pulse 2s ease-out infinite;
}

@keyframes ai-pulse {
  0% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.8; }
  100% { transform: translate(-50%, -50%) scale(1.6); opacity: 0; }
}

.ai-banner-content {
  flex: 1;
  color: white;
}

.ai-banner-title {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.ai-banner-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 14rpx;
}

.ai-banner-tags {
  display: flex;
  gap: 12rpx;
}

.ai-tag {
  background: rgba(255, 255, 255, 0.22);
  color: white;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.ai-banner-arrow {
  color: white;
  font-size: 60rpx;
  font-weight: 300;
  margin-left: 8rpx;
  line-height: 1;
  opacity: 0.85;
}

/* ===== 分区标题 ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: flex;
  align-items: center;
}

.section-title-tag {
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #2196F3, #1976D2);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-action {
  font-size: 26rpx;
  color: #888;
}

/* ===== 横滑功能 ===== */
.feature-scroll {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}

.feature-item {
  display: inline-block;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-right: 20rpx;
  text-align: center;
  min-width: 200rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  vertical-align: top;
}

.feature-item-orange {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
}

.feature-item-blue {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
}

.feature-item:active {
  transform: scale(0.97);
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.feature-extra {
  font-size: 24rpx;
  color: #888;
}

.feature-extra-bold {
  color: #E65100;
  font-weight: bold;
  font-size: 32rpx;
}

/* ===== 预警列表 ===== */
.alert-list {
  padding: 0 24rpx;
}

.alert-item {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.08);
  transition: all 0.2s;
}

.alert-item:active {
  transform: scale(0.99);
  background: #fafbff;
}

.alert-bar {
  width: 8rpx;
  background: linear-gradient(180deg, #ff6b6b, #ee5a52);
}

.alert-body {
  flex: 1;
  padding: 24rpx;
}

.alert-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.alert-tag {
  background: linear-gradient(135deg, #ffebee, #ffcdd2);
  color: #b71c1c;
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.alert-date {
  font-size: 24rpx;
  color: #aaa;
}

.alert-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.alert-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  display: block;
}

/* ===== 底部占位 ===== */
.footer-blank {
  height: 60rpx;
}

/* ===== 通用免责说明（避免虚假安全感） ===== */
.footer-disclaimer {
  margin: 32rpx 24rpx 24rpx;
  padding: 20rpx 24rpx;
  background-color: #fff8e1;
  border-left: 6rpx solid #f57c00;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5d4037;
}
