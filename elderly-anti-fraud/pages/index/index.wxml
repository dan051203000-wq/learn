<view class="container">
  <!-- 顶部欢迎 banner -->
  <view class="header">
    <view class="header-row">
      <view class="header-greeting">
        <view class="header-wave">👋</view>
        <view class="header-text">
          <view class="header-name">{{ userName || '朋友' }}</view>
          <view class="header-sub">遇到可疑信息，先来识别一下</view>
        </view>
      </view>
    </view>
    <view class="header-title">保护您的钱袋子</view>
    <view class="header-tip">陌生链接不点  验证码不给  汇款先核实</view>
  </view>

  <!-- 4 大核心功能 -->
  <view class="quick-grid">
    <view class="grid-item" bindtap="goIdentify">
      <view class="grid-icon-wrap grid-icon-blue">🔍</view>
      <view class="grid-title">识别诈骗</view>
      <view class="grid-desc">可疑链接 · 短信</view>
    </view>
    <view class="grid-item" bindtap="goCommunity">
      <view class="grid-icon-wrap grid-icon-green">💬</view>
      <view class="grid-title">求助社区</view>
      <view class="grid-desc">问问大家</view>
    </view>
    <view class="grid-item" bindtap="goReport">
      <view class="grid-icon-wrap grid-icon-red">🚨</view>
      <view class="grid-title">举报诈骗</view>
      <view class="grid-desc">一键举报</view>
    </view>
    <view class="grid-item" bindtap="goFamily">
      <view class="grid-icon-wrap grid-icon-orange">👨‍👩‍👧</view>
      <view class="grid-title">家庭守护</view>
      <view class="grid-desc">守护亲人</view>
    </view>
  </view>

  <!-- 横滑更多功能 -->
  <view class="section-header">
    <view class="section-title">
      <view class="section-title-tag"></view>
      更多工具
    </view>
  </view>
  <scroll-view class="feature-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="feature-item" bindtap="goCases">
      <view class="feature-icon">📖</view>
      <view class="feature-title">真实案例</view>
      <view class="feature-extra">看别人经历</view>
    </view>
    <view class="feature-item" bindtap="goKnowledge">
      <view class="feature-icon">📚</view>
      <view class="feature-title">防诈知识</view>
      <view class="feature-extra">学防骗技巧</view>
    </view>
    <view class="feature-item feature-item-orange" bindtap="callHotline">
      <view class="feature-icon">📞</view>
      <view class="feature-title">反诈专线</view>
      <view class="feature-extra feature-extra-bold">96110</view>
    </view>
    <view class="feature-item" bindtap="about">
      <view class="feature-icon">ℹ️</view>
      <view class="feature-title">关于我们</view>
      <view class="feature-extra">了解应用</view>
    </view>
  </scroll-view>

  <!-- 最新诈骗警报 -->
  <view class="section-header">
    <view class="section-title">
      <view class="section-title-tag"></view>
      最新诈骗预警
    </view>
    <view class="section-action">{{alerts.length}} 条预警</view>
  </view>

  <view class="alert-list" wx:if="{{alerts.length > 0}}">
    <view class="alert-item" wx:for="{{alerts}}" wx:key="id" bindtap="viewAlertDetail" data-id="{{item.id}}">
      <view class="alert-bar"></view>
      <view class="alert-body">
        <view class="alert-row">
          <view class="alert-tag">⚠️ 高发</view>
          <view class="alert-date">{{item.date}}</view>
        </view>
        <view class="alert-title">{{item.title}}</view>
        <view class="alert-desc">{{item.description}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-icon">🛡️</view>
    <view>暂无非紧急预警，请保持警惕</view>
  </view>

  <!-- 底部留白避免被 tabBar 遮挡 -->
  <view class="footer-blank"></view>
</view>
