/* ========== 举报 v2：适老化 ===== */
.container {
  padding: 0 0 60rpx;
  background-color: #f4f6fa;
  min-height: 100vh;
}

/* 紧急提示 */
.urgent-bar {
  background: linear-gradient(135deg, #c62828, #ef5350);
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 36rpx 32rpx;
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(198, 40, 40, 0.25);
}

.urgent-text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
  line-height: 1.7;
}

.urgent-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.urgent-call {
  flex: 1;
  background-color: white;
  color: #c62828;
  border-radius: 32rpx;
  text-align: center;
  font-size: 32rpx !important;
  font-weight: bold;
  padding: 16rpx 0;
  border: none;
  min-height: 88rpx;
  line-height: 88rpx;
}

.urgent-call.anti {
  background-color: #fff3e0;
  color: #e65100;
}

/* 表单卡片 */
.form-card,
.records-card,
.channel-card {
  background-color: white;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
}

.form-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #c62828, #ef5350);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.required {
  color: #c62828;
}

.picker-value,
.form-input {
  background-color: #f8f9fc;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx !important;
  color: #1a1a1a;
}

.picker-value.placeholder {
  color: #aaa;
}

.form-textarea {
  width: 100%;
  height: 240rpx;
  background-color: #f8f9fc;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx !important;
  line-height: 1.7;
  box-sizing: border-box;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.preview {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.image-remove {
  position: absolute;
  right: -12rpx;
  top: -12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c62828, #b71c1c);
  color: white;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 4rpx dashed #c8d3e0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: #c8d3e0;
  background: #f8f9fc;
}

/* 提交按钮 */
.submit-btn {
  background: linear-gradient(135deg, #c62828, #b71c1c);
  color: white;
  border-radius: 40rpx;
  font-size: 34rpx !important;
  font-weight: bold;
  margin-top: 16rpx;
  padding: 6rpx 0;
  min-height: 96rpx;
  line-height: 96rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 16rpx rgba(198, 40, 40, 0.3);
  border: none;
}

.submit-btn[disabled] {
  background: #e57373;
  color: white;
}

/* 举报记录 */
.record-item {
  border-bottom: 2rpx solid #f5f7fa;
  padding: 24rpx 0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-type {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.record-status {
  font-size: 26rpx;
  color: #2e7d32;
  background: #e8f5e9;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  font-weight: 500;
}

.record-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  margin-top: 14rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.record-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 其他举报渠道 */
.channel-tip {
  font-size: 26rpx;
  color: #777;
  line-height: 1.6;
  margin: -8rpx 0 16rpx;
  padding: 16rpx 20rpx;
  background-color: #fff8e1;
  border-left: 6rpx solid #ffa726;
  border-radius: 8rpx;
}
.channel-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.channel-item:last-child {
  border-bottom: none;
}

.channel-name {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.channel-value {
  font-size: 32rpx;
  color: #2196F3;
  font-weight: bold;
}
