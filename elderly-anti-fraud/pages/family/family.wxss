/* ========== 家庭守护 v2：适老化 + 大圆角 ===== */
.container {
  padding: 0 0 60rpx;
  background-color: #f4f6fa;
  min-height: 100vh;
}

/* ===== 顶部说明 banner ===== */
.page-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  margin: 20rpx 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  border-left: 8rpx solid #2196F3;
}

.tip-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.tip-text {
  flex: 1;
  font-size: 30rpx;
  color: #0d47a1;
  line-height: 1.6;
  font-weight: 500;
}

/* ===== 角色选择 ===== */
.role-card {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 24rpx;
  margin: 0 24rpx 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.role-card:active {
  transform: scale(0.99);
}

.role-icon {
  font-size: 72rpx;
  margin-right: 28rpx;
}

.role-info {
  flex: 1;
}

.role-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.role-desc {
  font-size: 28rpx;
  color: #777;
  margin-top: 12rpx;
  line-height: 1.6;
}

.role-arrow {
  font-size: 48rpx;
  color: #ccc;
  font-weight: bold;
}

/* ===== 守护码卡片 ===== */
.code-card {
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
  border-radius: 28rpx;
  margin: 20rpx 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(33, 150, 243, 0.3);
  position: relative;
  overflow: hidden;
}

.code-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.code-title {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.code-number {
  font-size: 96rpx;
  font-weight: bold;
  color: white;
  letter-spacing: 20rpx;
  margin: 32rpx 0;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  position: relative;
  z-index: 1;
}

.code-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.7;
  position: relative;
  z-index: 1;
}

.code-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  position: relative;
  z-index: 1;
}

.code-btn {
  flex: 1;
  border-radius: 32rpx;
  font-size: 30rpx !important;
  font-weight: bold;
  padding: 4rpx 0;
  margin: 0;
  min-height: 80rpx;
  line-height: 80rpx;
}

.code-btn.primary {
  background-color: white;
  color: #2196F3;
  border: none;
}

.code-btn.primary:active {
  background-color: #f0f0f0;
}

.code-btn.plain {
  background-color: rgba(255, 255, 255, 0.25);
  color: white;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.code-btn.plain:active {
  background-color: rgba(255, 255, 255, 0.35);
}

.switch-role {
  text-align: center;
  font-size: 28rpx;
  color: #888;
  padding: 24rpx 0;
}

/* ===== 绑定卡片 ===== */
.bind-card {
  background-color: white;
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.bind-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.bind-desc {
  font-size: 28rpx;
  color: #888;
  margin-top: 16rpx;
  line-height: 1.7;
}

.bind-toggle {
  text-align: center;
  color: #2196F3;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 28rpx;
  padding: 16rpx 0;
}

.bind-item {
  margin-top: 32rpx;
}

.bind-label {
  font-size: 30rpx;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.bind-input {
  background-color: #f8f9fc;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx !important;
}

.bind-input:focus {
  background-color: white;
  border-color: #2196F3;
}

.bind-submit {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  color: white;
  border-radius: 32rpx;
  font-size: 32rpx !important;
  font-weight: bold;
  margin-top: 40rpx;
  padding: 4rpx 0;
  min-height: 88rpx;
  line-height: 88rpx;
  border: none;
}

/* ===== 成员/动态/提醒 卡片 ===== */
.members-card,
.events-card,
.remind-card {
  background-color: white;
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.members-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.members-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #2196F3, #1976D2);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  color: #2e7d32;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.member-meta {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.member-remove {
  font-size: 28rpx;
  color: #b71c1c;
  padding: 12rpx 24rpx;
  background: #ffebee;
  border-radius: 30rpx;
  font-weight: 500;
}

/* ===== 快捷提醒 ===== */
.remind-card {
  display: flex;
  align-items: center;
}

.remind-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.remind-text {
  flex: 1;
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.remind-arrow {
  font-size: 48rpx;
  color: #ccc;
  font-weight: bold;
}

/* ===== 守护动态 ===== */
.event-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.event-item:last-child {
  border-bottom: none;
}

.event-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2196F3, #1976D2);
  margin: 18rpx 24rpx 0 8rpx;
  flex-shrink: 0;
}

.event-main {
  flex: 1;
}

.event-text {
  font-size: 30rpx;
  color: #444;
  line-height: 1.7;
}

.event-result {
  color: #e65100;
  font-weight: bold;
  background: #fff3e0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.event-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ===== 底部 96110 ===== */
.hotline-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
}

.hotline-left {
  flex: 1;
}

.hotline-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.hotline-desc {
  font-size: 26rpx;
  color: #777;
  margin-top: 8rpx;
}

.hotline-phone {
  font-size: 64rpx;
  color: #e65100;
  font-weight: bold;
}
