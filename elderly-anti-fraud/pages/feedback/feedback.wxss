/* ===== 页面通用 ===== */
.page-header {
  padding: 32rpx 24rpx 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.page-subtitle {
  font-size: 28rpx;
  color: #666;
  margin-top: 12rpx;
  line-height: 1.6;
}

.section-card {
  background-color: #fff;
  margin: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

/* ===== 类型选择 2x2 ===== */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-btn {
  flex: 1 0 40%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background-color: #f5f7fa;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.type-btn.active {
  background-color: #e3f2fd;
  border-color: #2196F3;
}

.type-icon {
  font-size: 40rpx;
}

.type-text {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}

/* ===== 文本框 ===== */
.feedback-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1a1a1a;
  background-color: #fafbfc;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.char-count {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  text-align: right;
}

/* ===== 联系方式 ===== */
.contact-tip {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.contact-input {
  width: 100%;
  padding: 20rpx;
  font-size: 30rpx;
  background-color: #fafbfc;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* ===== 隐私提示 ===== */
.privacy-tip {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  background-color: #fff8e1;
  border-left: 6rpx solid #f57c00;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5d4037;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  margin: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background-color: #2196F3;
  color: white;
  border: none;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 34rpx;
  font-weight: bold;
  min-height: 96rpx;
}

.submit-btn[disabled] {
  background-color: #90caf9;
}

.submit-icon {
  font-size: 36rpx;
}

.submit-text {
  font-size: 34rpx;
  font-weight: bold;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.footer-blank {
  height: 60rpx;
}