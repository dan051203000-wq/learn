/* AI 反诈顾问页样式 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

/* ===== 顶部 AI banner ===== */
.ai-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #1976D2, #1565C0);
  color: #fff;
}

.ai-banner-left {
  display: flex;
  align-items: center;
}

.ai-banner-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.ai-banner-title {
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.ai-banner-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.ai-banner-tag {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
}

/* ===== 对话区 ===== */
.chat-scroll {
  flex: 1;
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.msg-user .msg-avatar {
  margin-left: 16rpx;
}

.msg-ai .msg-avatar {
  margin-right: 16rpx;
}

.msg-bubble {
  max-width: 75%;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-word;
}

.msg-bubble-ai {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.msg-bubble-user {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg-meta {
  font-size: 22rpx;
  opacity: 0.6;
  margin-top: 8rpx;
}

/* 打字动画 */
.msg-bubble-typing {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx;
}

.typing-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #90CAF9;
  margin: 0 4rpx;
  animation: typing 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) { animation-delay: 0.15s; }
.typing-dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes typing {
  0%, 60%, 100% { transform: scale(0.7); opacity: 0.5; }
  30% { transform: scale(1); opacity: 1; }
}

/* ===== 快捷提问 ===== */
.quick-questions {
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 2rpx solid #e8eef5;
}

.quick-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  background: #f5f9ff;
  border: 2rpx solid #e3f2fd;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.quick-item:active {
  background: #e3f2fd;
}

.quick-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.quick-text {
  font-size: 26rpx;
  color: #1976D2;
  line-height: 1.4;
  flex: 1;
}

/* ===== 输入区 ===== */
.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #e8eef5;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input {
  flex: 1;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  margin-right: 16rpx;
}

.send-btn {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 32rpx;
  margin: 0;
}

.send-btn[disabled] {
  background: #ccc;
  color: #fff;
}

/* ===== 救援模式 ===== */
.page-rescue {
  background: #fff5f5;
}

.ai-banner-rescue {
  background: linear-gradient(135deg, #c62828, #b71c1c);
}

/* 普通模式常驻救援入口（醒目红色条） */
.rescue-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ef5350, #e53935);
  color: #fff;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.rescue-entry-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.rescue-entry:active {
  opacity: 0.85;
}

/* 救援模式顶部操作条 */
.rescue-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #ffcdd2;
}

.rescue-call {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #c62828, #b71c1c);
  color: #fff;
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
}

.rescue-call-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.rescue-call-text {
  font-size: 30rpx;
  font-weight: bold;
}

.rescue-exit {
  font-size: 26rpx;
  color: #999;
  padding: 10rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 30rpx;
}

/* 救援追问 chips */
.rescue-chips {
  background: #fff;
  border-top: 2rpx solid #ffcdd2;
}

.rescue-chips-title {
  color: #c62828 !important;
}

.rescue-chips-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rescue-chip {
  display: flex;
  align-items: center;
  background: #ffebee;
  border: 2rpx solid #ffcdd2;
  border-radius: 30rpx;
  padding: 14rpx 24rpx;
  flex: 1 1 45%;
  box-sizing: border-box;
}

.rescue-chip:active {
  background: #ffcdd2;
}

.rescue-chip-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.rescue-chip-text {
  font-size: 25rpx;
  color: #c62828;
  line-height: 1.3;
}
