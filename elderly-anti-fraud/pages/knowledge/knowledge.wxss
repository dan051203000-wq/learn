/* ========== 防诈知识 v2：适老化 ===== */
.container {
  padding: 0 0 60rpx;
  background-color: #f4f6fa;
  min-height: 100vh;
}

/* 顶部提示 */
.page-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  margin: 20rpx 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  border-left: 8rpx solid #43A047;
}

.tip-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.tip-text {
  flex: 1;
  font-size: 30rpx;
  color: #1b5e20;
  line-height: 1.7;
  font-weight: 500;
}

/* 分类筛选 */
.category-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx;
}

.category-item {
  display: inline-block;
  background-color: white;
  color: #555;
  border: 2rpx solid #e0e6ed;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 16rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #43A047, #2e7d32);
  color: white;
  border-color: #43A047;
  font-weight: bold;
}

/* 小测试入口 */
.quiz-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #2196F3, #1976D2);
  border-radius: 28rpx;
  margin: 20rpx 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(33, 150, 243, 0.3);
  color: white;
}

.quiz-entry-title {
  font-size: 38rpx;
  font-weight: bold;
  color: white;
}

.quiz-entry-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
}

.quiz-entry-btn {
  background-color: white;
  color: #2196F3;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx !important;
  font-weight: bold;
  border: none;
}

/* 文章列表 */
.article-card {
  display: flex;
  background-color: white;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.article-card:active {
  transform: scale(0.99);
}

.article-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.article-main {
  flex: 1;
  min-width: 0;
}

.article-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.5;
}

.article-summary {
  font-size: 28rpx;
  color: #777;
  line-height: 1.7;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.article-category {
  font-size: 26rpx;
  color: #2196F3;
  font-weight: 500;
}

.article-read {
  font-size: 26rpx;
  color: #999;
}

/* 弹窗通用 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-popup {
  width: 100%;
  max-height: 85vh;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx 40rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.5;
}

.detail-category {
  font-size: 28rpx;
  color: #2196F3;
  margin: 16rpx 0 12rpx;
  font-weight: 500;
}

.detail-line {
  display: flex;
  margin-top: 24rpx;
}

.detail-num {
  font-size: 32rpx;
  color: #2196F3;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.detail-text {
  font-size: 32rpx;
  color: #444;
  line-height: 1.8;
  flex: 1;
}

.detail-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
  padding-bottom: 24rpx;
}

.detail-btn {
  flex: 1;
  border-radius: 40rpx;
  font-size: 32rpx !important;
  padding: 16rpx 0;
  border: none;
  font-weight: bold;
  min-height: 88rpx;
  line-height: 88rpx;
}

.detail-btn.primary {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  color: white;
}

.detail-btn.plain {
  background: #f0f3f7;
  color: #555;
}

/* 小测试 */
.quiz-popup {
  padding-bottom: 60rpx;
}

.quiz-progress {
  font-size: 28rpx;
  color: #2196F3;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding: 12rpx 24rpx;
  background: #e3f2fd;
  border-radius: 30rpx;
  display: inline-block;
}

.quiz-question-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.7;
  margin-bottom: 36rpx;
}

.quiz-option {
  display: flex;
  align-items: center;
  border: 4rpx solid #e0e6ed;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.6;
  transition: all 0.2s;
}

.quiz-option:active {
  transform: scale(0.99);
}

.quiz-option.selected {
  border-color: #2196F3;
  background: #e3f2fd;
}

.quiz-option.correct {
  border-color: #2e7d32;
  background: #e8f5e9;
}

.quiz-option.wrong {
  border-color: #b71c1c;
  background: #ffebee;
}

.option-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #f0f3f7;
  color: #555;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.quiz-option.correct .option-letter {
  background: #2e7d32;
  color: white;
}

.quiz-option.wrong .option-letter {
  background: #b71c1c;
  color: white;
}

.option-text {
  flex: 1;
}

.quiz-explain {
  background: #fff8e1;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #bf360c;
  line-height: 1.7;
  margin-top: 12rpx;
}

.quiz-next-btn {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  color: white;
  border-radius: 40rpx;
  font-size: 32rpx !important;
  font-weight: bold;
  margin-top: 32rpx;
  padding: 6rpx 0;
  min-height: 88rpx;
  line-height: 88rpx;
  border: none;
}

.quiz-result-icon {
  text-align: center;
  font-size: 120rpx;
  margin-top: 24rpx;
}

.quiz-result-score {
  text-align: center;
  font-size: 72rpx;
  font-weight: bold;
  color: #2196F3;
  margin-top: 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(33, 150, 243, 0.2);
}

.quiz-result-text {
  text-align: center;
  font-size: 30rpx;
  color: #555;
  line-height: 1.7;
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.quiz-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}
