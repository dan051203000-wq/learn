.container {
  padding: 20rpx 0 60rpx;
}

/* 顶部提示 */
.page-tip {
  display: flex;
  align-items: center;
  background-color: #e8f5e9;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #2e7d32;
  line-height: 1.5;
}

/* 分类筛选 */
.category-bar {
  white-space: nowrap;
  padding: 10rpx 20rpx;
}

.category-item {
  display: inline-block;
  background-color: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.category-item.active {
  background-color: #2196F3;
  color: white;
  border-color: #2196F3;
  font-weight: bold;
}

/* 小测试入口 */
.quiz-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #2196F3, #64b5f6);
  border-radius: 12rpx;
  margin: 10rpx 20rpx 20rpx;
  padding: 28rpx;
}

.quiz-entry-title {
  font-size: 34rpx;
  font-weight: bold;
  color: white;
}

.quiz-entry-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.quiz-entry-btn {
  background-color: white;
  color: #2196F3;
  border-radius: 30rpx;
  padding: 14rpx 30rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 文章列表 */
.article-card {
  display: flex;
  background-color: white;
  border-radius: 12rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.article-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.article-main {
  flex: 1;
}

.article-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
}

.article-summary {
  font-size: 26rpx;
  color: #777;
  line-height: 1.6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.article-category {
  font-size: 22rpx;
  color: #2196F3;
}

.article-read {
  font-size: 22rpx;
  color: #999;
}

/* 弹窗通用 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-popup {
  width: 100%;
  max-height: 85vh;
  background-color: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
}

.detail-category {
  font-size: 24rpx;
  color: #2196F3;
  margin: 12rpx 0 8rpx;
}

.detail-line {
  display: flex;
  margin-top: 20rpx;
}

.detail-num {
  font-size: 28rpx;
  color: #2196F3;
  font-weight: bold;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.detail-text {
  font-size: 29rpx;
  color: #444;
  line-height: 1.8;
  flex: 1;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
  padding-bottom: 20rpx;
}

.detail-btn {
  flex: 1;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
  border: none;
}

.detail-btn.primary {
  background-color: #2196F3;
  color: white;
}

.detail-btn.plain {
  background-color: #f0f0f0;
  color: #333;
}

/* 小测试 */
.quiz-popup {
  padding-bottom: 60rpx;
}

.quiz-progress {
  font-size: 26rpx;
  color: #2196F3;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.quiz-question-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.quiz-option {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  font-size: 29rpx;
  color: #444;
  line-height: 1.5;
}

.quiz-option.selected {
  border-color: #2196F3;
  background-color: #e3f2fd;
}

.quiz-option.correct {
  border-color: #2e7d32;
  background-color: #e8f5e9;
}

.quiz-option.wrong {
  border-color: #c62828;
  background-color: #ffebee;
}

.option-letter {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  color: #666;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.quiz-option.correct .option-letter {
  background-color: #2e7d32;
  color: white;
}

.quiz-option.wrong .option-letter {
  background-color: #c62828;
  color: white;
}

.option-text {
  flex: 1;
}

.quiz-explain {
  background-color: #fff8e1;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #e65100;
  line-height: 1.6;
  margin-top: 8rpx;
}

.quiz-next-btn {
  background-color: #2196F3;
  color: white;
  border-radius: 40rpx;
  font-size: 32rpx;
  margin-top: 28rpx;
  padding: 6rpx 0;
}

.quiz-result-icon {
  text-align: center;
  font-size: 100rpx;
  margin-top: 20rpx;
}

.quiz-result-score {
  text-align: center;
  font-size: 60rpx;
  font-weight: bold;
  color: #2196F3;
  margin-top: 16rpx;
}

.quiz-result-text {
  text-align: center;
  font-size: 30rpx;
  color: #555;
  line-height: 1.7;
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.quiz-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
