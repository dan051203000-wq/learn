<view class="container {{fontLarge ? 'font-large' : ''}}">
  <!-- 用户信息 -->
  <view class="user-card">
    <view class="user-avatar">{{nickName[0]}}</view>
    <view class="user-info">
      <view class="user-name">{{nickName}}</view>
      <view class="user-desc">防诈骗，从每一天做起</view>
    </view>
    <view class="user-edit" bindtap="editName">✏️ 改称呼</view>
  </view>

  <!-- 防诈成绩 -->
  <view class="stats-card">
    <view class="stat-item">
      <view class="stat-num">{{stats.identifyCount}}</view>
      <view class="stat-label">识别次数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{stats.reportCount}}</view>
      <view class="stat-label">举报次数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{stats.learnDays}}</view>
      <view class="stat-label">学习天数</view>
    </view>
  </view>

  <!-- 适老化设置 -->
  <view class="section-card">
    <view class="section-title">⚙️ 适老化设置</view>
    <view class="setting-item">
      <view class="setting-left">
        <view class="setting-title">🔍 大字模式</view>
        <view class="setting-desc">放大页面文字，看得更清楚</view>
      </view>
      <switch checked="{{fontLarge}}" color="#2196F3" bindchange="toggleFont" />
    </view>
  </view>

  <!-- 识别历史 -->
  <view class="section-card">
    <view class="section-title-row">
      <view class="section-title">🕘 识别历史</view>
      <view class="section-action" bindtap="clearHistory">清空</view>
    </view>

    <view
      class="history-item"
      wx:for="{{history}}"
      wx:key="_id"
      bindtap="viewHistoryDetail"
      data-index="{{index}}"
    >
      <view class="history-main">
        <view class="history-text">{{item.text}}</view>
        <view class="history-time">{{item.timeText}}</view>
      </view>
      <view class="risk-level {{item.riskClass}}">{{item.riskLevelText}}</view>
    </view>

    <view class="history-empty" wx:if="{{history.length === 0}}">
      <view class="history-empty-text">还没有识别记录</view>
      <view class="history-empty-btn" bindtap="goIdentify">🔍 去识别一条</view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section-card">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="title" bindtap="goMenu" data-url="{{item.url}}">
      <view class="menu-title">{{item.icon}} {{item.title}}</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="callHotline">
      <view class="menu-title">📞 反诈专线 96110</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="about">
      <view class="menu-title">ℹ️ 关于我们</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>
