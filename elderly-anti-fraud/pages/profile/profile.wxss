.container {
  padding: 20rpx 0 60rpx;
}

/* 大字模式：整体放大关键文字 */
.font-large .user-name,
.font-large .section-title,
.font-large .menu-title,
.font-large .history-text,
.font-large .setting-title,
.font-large .stat-num {
  font-size: 40rpx;
}

.font-large .user-desc,
.font-large .setting-desc,
.font-large .stat-label,
.font-large .history-time {
  font-size: 30rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2196F3, #64b5f6);
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 36rpx 32rpx;
}

.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background-color: white;
  color: #2196F3;
  font-size: 48rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
}

.user-edit {
  font-size: 24rpx;
  color: white;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
}

/* 防诈成绩 */
.stats-card {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 12rpx;
  margin: 0 20rpx 20rpx;
  padding: 30rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #2196F3;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #eee;
}

/* 区块卡片 */
.section-card {
  background-color: white;
  border-radius: 12rpx;
  margin: 0 20rpx 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-title-row .section-title {
  margin-bottom: 0;
}

.section-action {
  font-size: 25rpx;
  color: #999;
}

/* 设置 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-title {
  font-size: 29rpx;
  color: #333;
  font-weight: bold;
}

.setting-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 识别历史 */
.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-main {
  flex: 1;
  margin-right: 16rpx;
}

.history-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.history-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.history-empty {
  text-align: center;
  padding: 30rpx 0;
}

.history-empty-text {
  font-size: 26rpx;
  color: #999;
}

.history-empty-btn {
  display: inline-block;
  background-color: #2196F3;
  color: white;
  font-size: 26rpx;
  border-radius: 30rpx;
  padding: 12rpx 36rpx;
  margin-top: 20rpx;
}

/* 功能入口 */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 29rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}
