/* ========== 案例 v2：适老化 ===== */
.container {
  padding: 0 0 60rpx;
  background-color: #f4f6fa;
  min-height: 100vh;
}

/* 顶部提示 */
.page-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  margin: 20rpx 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  border-left: 8rpx solid #2196F3;
}

.tip-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.tip-text {
  flex: 1;
  font-size: 30rpx;
  color: #0d47a1;
  line-height: 1.7;
  font-weight: 500;
}

/* 分类筛选 */
.category-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx;
}

.category-item {
  display: inline-block;
  background-color: white;
  color: #555;
  border: 2rpx solid #e0e6ed;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 16rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  color: white;
  border-color: #2196F3;
  font-weight: bold;
}

/* 案例列表 */
.case-list {
  padding: 0 24rpx;
}

.case-card {
  background-color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.case-card:active {
  transform: scale(0.99);
}

.case-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.case-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.4;
}

.case-category {
  font-size: 24rpx;
  color: #2196F3;
  margin-top: 12rpx;
  font-weight: 500;
}

.case-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  margin-top: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.case-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.case-date {
  font-size: 26rpx;
  color: #999;
}

.case-more {
  font-size: 28rpx;
  color: #2196F3;
  font-weight: 600;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  background: white;
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  display: block;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-top: 24rpx;
}

/* 去识别入口 */
.go-identify {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.go-identify-text {
  font-size: 32rpx;
  color: #1a1a1a;
  flex: 1;
  font-weight: 500;
}

.go-identify-btn {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  color: white;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx !important;
  font-weight: bold;
  border: none;
}

/* 详情弹窗 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-popup {
  width: 100%;
  max-height: 85vh;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx 40rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.4;
}

.detail-tags {
  display: flex;
  align-items: center;
  margin: 20rpx 0 12rpx;
}

.detail-category {
  font-size: 26rpx;
  color: #2196F3;
  margin-right: 20rpx;
  font-weight: 500;
}

.detail-section {
  margin-top: 32rpx;
}

.detail-section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.detail-section-body {
  font-size: 30rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.detail-section-body.loss {
  color: #b71c1c;
  font-weight: bold;
  background: #ffebee;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
}

.tip-item {
  font-size: 30rpx;
  color: #2e7d32;
  line-height: 1.9;
  margin-bottom: 12rpx;
}

.detail-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
  padding-bottom: 24rpx;
}

.detail-btn {
  flex: 1;
  border-radius: 40rpx;
  font-size: 32rpx !important;
  padding: 16rpx 0;
  border: none;
  font-weight: bold;
  min-height: 88rpx;
  line-height: 88rpx;
}

.detail-btn.share {
  background: linear-gradient(135deg, #2196F3, #1976D2);
  color: white;
}

.detail-btn.close {
  background: #f0f3f7;
  color: #555;
}
