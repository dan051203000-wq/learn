.container {
  padding: 20rpx 0 60rpx;
}

/* 顶部提示 */
.page-tip {
  display: flex;
  align-items: center;
  background-color: #e3f2fd;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #1565c0;
  line-height: 1.5;
}

/* 分类筛选 */
.category-bar {
  white-space: nowrap;
  padding: 10rpx 20rpx;
}

.category-item {
  display: inline-block;
  background-color: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.category-item.active {
  background-color: #2196F3;
  color: white;
  border-color: #2196F3;
  font-weight: bold;
}

/* 案例列表 */
.case-list {
  padding: 0 20rpx;
}

.case-card {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.case-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.case-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.case-category {
  font-size: 24rpx;
  color: #2196F3;
  margin-top: 8rpx;
}

.case-desc {
  font-size: 27rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.case-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.case-date {
  font-size: 24rpx;
  color: #999;
}

.case-more {
  font-size: 24rpx;
  color: #2196F3;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

/* 去识别入口 */
.go-identify {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.go-identify-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.go-identify-btn {
  background-color: #2196F3;
  color: white;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
}

/* 详情弹窗 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-popup {
  width: 100%;
  max-height: 85vh;
  background-color: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.detail-tags {
  display: flex;
  align-items: center;
  margin: 16rpx 0 8rpx;
}

.detail-category {
  font-size: 24rpx;
  color: #2196F3;
  margin-right: 16rpx;
}

.detail-section {
  margin-top: 28rpx;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.detail-section-body {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.detail-section-body.loss {
  color: #c62828;
  font-weight: bold;
}

.tip-item {
  font-size: 28rpx;
  color: #2e7d32;
  line-height: 1.8;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
  padding-bottom: 20rpx;
}

.detail-btn {
  flex: 1;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
  border: none;
}

.detail-btn.share {
  background-color: #2196F3;
  color: white;
}

.detail-btn.close {
  background-color: #f0f0f0;
  color: #333;
}
